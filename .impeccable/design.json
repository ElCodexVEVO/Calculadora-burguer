  "components": [
    {
      "name": "Acción principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Guardar o confirmar una acción con estado habilitado o deshabilitado.",
      "html": "<button class=\"ds-btn-primary\">Guardar cambios</button>",
      "css": ".ds-btn-primary{min-height:42px;padding:10px 16px;border:1px solid var(--bs-orange-soft,#FFA63B);border-radius:9px;background:linear-gradient(110deg,var(--bs-gold,#FFB347),var(--bs-orange,#FF891C));color:var(--bs-wine,#230910);font:700 14px/1.15 var(--o-font,Archivo,system-ui,sans-serif);cursor:pointer;box-shadow:0 7px 20px -13px #ff891c;transition:filter .16s,box-shadow .2s}.ds-btn-primary:hover{filter:brightness(1.06);box-shadow:0 9px 26px -12px #ff891c}.ds-btn-primary:active{transform:scale(.97)}.ds-btn-primary:disabled{background:var(--o-surface-3,#38232b);color:var(--bs-muted,#BCA9A8);border-color:rgba(246,235,217,.17);cursor:not-allowed}.ds-btn-primary:focus-visible{outline:2px solid var(--bs-gold,#FFB347);outline-offset:3px}"
    },
    {
      "name": "Acción secundaria",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Cancelar o abrir una acción auxiliar sin competir con el botón principal.",
      "html": "<button class=\"ds-btn-secondary\">Cancelar</button>",
      "css": ".ds-btn-secondary{min-height:42px;padding:10px 16px;border:1px solid rgba(246,235,217,.17);border-radius:9px;background:var(--o-surface-2,#2c1920);color:var(--bs-text,#FFF0DF);font:700 14px/1.15 var(--o-font,Archivo,system-ui,sans-serif);cursor:pointer;transition:background .16s,border-color .16s}.ds-btn-secondary:hover{background:var(--o-surface-3,#38232b);border-color:rgba(246,235,217,.28)}.ds-btn-secondary:active{transform:scale(.97)}.ds-btn-secondary:focus-visible{outline:2px solid var(--bs-gold,#FFB347);outline-offset:3px}"
    },
    {
      "name": "Campo de red social",
      "kind": "input",
      "refersTo": "social-input",
      "description": "Campo opcional con etiqueta persistente; el error de guardado se muestra en el formulario.",
      "html": "<label class=\"ds-field\">Instagram<input class=\"ds-social-input\" placeholder=\"@tuusuario\" autocomplete=\"off\" autocapitalize=\"none\" spellcheck=\"false\"></label>",
      "css": ".ds-field{display:grid;gap:8px;max-width:300px;color:#ecd3c3;font:11px var(--o-font,Archivo,system-ui,sans-serif)}.ds-social-input{height:43px;padding:0 12px;border:1px solid #664039;border-radius:8px;background:#13070d;color:var(--bs-text,#FFF0DF);font:13px var(--o-font,Archivo,system-ui,sans-serif);caret-color:var(--bs-gold,#FFB347);transition:border-color .16s}.ds-social-input::placeholder{color:var(--bs-muted,#BCA9A8)}.ds-social-input:hover{border-color:#9d5b44}.ds-social-input:disabled{opacity:.65}.ds-social-input:focus-visible{outline:2px solid var(--bs-gold,#FFB347);outline-offset:3px}"
    },
    {
      "name": "Navegación roja",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "Destino activo con icono SVG, etiqueta legible y borde rojo luminoso.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navegación de ejemplo\"><button class=\"ds-nav-item\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 10.5 12 3l9 7.5v9A1.5 1.5 0 0 1 19.5 21H15v-6H9v6H4.5A1.5 1.5 0 0 1 3 19.5z\"/></svg><span>Inicio</span></button></nav>",
      "css": ".ds-nav{padding:12px;background:#090205;max-width:240px}.ds-nav-item{display:flex;align-items:center;gap:13px;width:100%;min-height:44px;padding:9px 13px;border:1px solid #ff612d;border-radius:8px;background:linear-gradient(100deg,rgba(134,24,16,.85),rgba(71,11,9,.83));color:#fff5e8;box-shadow:inset 0 0 14px rgba(255,55,20,.35),0 2px 13px -3px rgba(255,59,20,.65);font:700 13px var(--o-font,Archivo,system-ui,sans-serif);cursor:pointer}.ds-nav-item svg{width:20px;height:20px;fill:none;stroke:#ffc363;stroke-width:1.5;filter:drop-shadow(0 1px 4px #ed4a15)}.ds-nav-item:hover{background-color:rgba(144,29,18,.28);border-color:#ff834f}.ds-nav-item:active{transform:scale(.98)}.ds-nav-item:focus-visible{outline:2px solid var(--bs-gold,#FFB347);outline-offset:3px}"
    },
    {
      "name": "Selector de periodo",
      "kind": "chip",
      "refersTo": "period-chip",
      "description": "Dos opciones excluyentes para las cuatro métricas propias.",
      "html": "<div class=\"ds-period\" role=\"group\" aria-label=\"Periodo de rendimiento\"><button class=\"ds-period-chip\" aria-pressed=\"true\">Esta semana</button><button class=\"ds-period-chip\" aria-pressed=\"false\">Total</button></div>",
      "css": ".ds-period{display:inline-flex;gap:4px;padding:4px;border:1px solid #613122;border-radius:10px;background:#100407}.ds-period-chip{min-height:35px;padding:8px 15px;border:0;border-radius:6px;background:none;color:#d9c3b6;font:600 11px var(--o-font,Archivo,system-ui,sans-serif);cursor:pointer;transition:background .16s}.ds-period-chip[aria-pressed=true]{background:#7b2015;color:#fff2df;box-shadow:inset 0 0 0 1px #d25d2a}.ds-period-chip:hover{background:#542017;color:#fff3e4}.ds-period-chip:active{transform:scale(.98)}.ds-period-chip:focus-visible{outline:2px solid var(--bs-gold,#FFB347);outline-offset:3px}"
    },
